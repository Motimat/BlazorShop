<header class="bs-v2-storefront-header">
    <a class="bs-v2-skip-link" href="#main-content">پرش به محتوای اصلی</a>
    <div class="bs-v2-header-main bs-v2-container">
        <a href="@StorefrontRoutes.Home" class="bs-v2-brand" aria-label="خانه فروشگاه عمومی">Blazor<span>Shop</span></a>

        <form class="bs-v2-header-search" method="get" action="@StorefrontRoutes.Catalog" role="search" aria-label="جستجوی محصولات">
            <label class="bs-v2-visually-hidden" for="shop-search">جستجوی محصولات</label>
            <input id="shop-search" name="q" type="search" maxlength="@StorefrontCatalogQuery.MaxSearchLength" placeholder="جستجوی محصولات…" />
            <button type="submit" class="bs-v2-button bs-v2-button-primary">جستجو</button>
        </form>

        <div class="bs-v2-header-actions" aria-label="دکمه‌های فروشگاه">
            <a href="@StorefrontRoutes.Cart" class="bs-v2-cart-action" aria-label="باز کردن سبد خرید" title="سبد خرید">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M3 4h2.2l1.8 10h10.7l2-7H6.1" />
                    <circle cx="9" cy="19" r="1.4" />
                    <circle cx="17" cy="19" r="1.4" />
                </svg>
                <span class="bs-v2-cart-label">سبد خرید</span>
                <span data-storefront-cart-badge hidden class="bs-storefront-cart-badge">0</span>
            </a>
            <StorefrontAccountMenu />
        </div>
    </div>

    <div class="bs-v2-navline">
        <nav class="bs-v2-container bs-v2-desktop-nav" aria-label="ناوبری اصلی فروشگاه">
            <NavLink href="@StorefrontRoutes.Home" Match="NavLinkMatch.All" ActiveClass="is-active">خانه</NavLink>
            <NavLink href="@StorefrontRoutes.Catalog" ActiveClass="is-active">کاتالوگ</NavLink>
            <NavLink href="@StorefrontRoutes.NewReleases" ActiveClass="is-active">جدیدترین‌ها</NavLink>
            <NavLink href="@StorefrontRoutes.TodaysDeals" ActiveClass="is-active">تخفیف‌ها</NavLink>
            <NavLink href="@StorefrontRoutes.About" ActiveClass="is-active">درباره ما</NavLink>
            <NavLink href="@StorefrontRoutes.CustomerService" ActiveClass="is-active">پشتیبانی</NavLink>
        </nav>
    </div>

    <details class="bs-v2-mobile-nav">
        <summary>مرور فروشگاه <span aria-hidden="true">☰</span></summary>
        <nav aria-label="ناوبری موبایل فروشگاه">
            <NavLink href="@StorefrontRoutes.Home" Match="NavLinkMatch.All" ActiveClass="is-active">خانه</NavLink>
            <NavLink href="@StorefrontRoutes.Catalog" ActiveClass="is-active">کاتالوگ</NavLink>
            <NavLink href="@StorefrontRoutes.NewReleases" ActiveClass="is-active">جدیدترین‌ها</NavLink>
            <NavLink href="@StorefrontRoutes.TodaysDeals" ActiveClass="is-active">تخفیف‌ها</NavLink>
            <NavLink href="@StorefrontRoutes.About" ActiveClass="is-active">درباره ما</NavLink>
            <NavLink href="@StorefrontRoutes.CustomerService" ActiveClass="is-active">پشتیبانی</NavLink>
        </nav>
    </details>
</header>