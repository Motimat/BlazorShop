@inject IStorefrontClientAppUrlResolver ClientAppUrlResolver

<footer class="bs-v2-footer">
    <div class="bs-v2-container">
        <div class="bs-v2-footer-grid">
            <div>
                <a class="bs-v2-brand" href="@StorefrontRoutes.Home">Blazor<span>Shop</span></a>
                <p>کشف محصولات، مرور مجموعه‌ها و پیگیری سفارش‌های خود با BlazorShop.</p>
            </div>
            <nav aria-label="ناوبری فروشگاه در فوتر">
                <h2>فروشگاه</h2>
                <a href="@StorefrontRoutes.Home">خانه</a>
                <a href="@StorefrontRoutes.Catalog">کاتالوگ</a>
                <a href="@StorefrontRoutes.NewReleases">جدیدترین‌ها</a>
                <a href="@StorefrontRoutes.TodaysDeals">تخفیف‌ها</a>
                <a href="@StorefrontRoutes.Cart">سبد خرید</a>
            </nav>
            <nav aria-label="ناوبری پشتیبانی در فوتر">
                <h2>پشتیبانی</h2>
                <a href="@StorefrontRoutes.CustomerService">پشتیبانی مشتری</a>
                <a href="@StorefrontRoutes.Faq">سوالات متداول</a>
                <a href="@StorefrontRoutes.About">درباره ما</a>
            </nav>
            <nav aria-label="ناوبری اطلاعات در فوتر">
                <h2>اطلاعات</h2>
                @if (_session.IsAuthenticated)
                {
                    <a href="@ClientAppUrlResolver.ResolveUrl("/account")">حساب من</a>
                    @if (_session.IsAdmin)
                    {
                        <a href="@ClientAppUrlResolver.ResolveUrl("/admin")">پنل ادمین</a>
                    }
                }
                else
                {
                    <a href="@StorefrontRoutes.SignIn">ورود</a>
                    <a href="@StorefrontRoutes.Register">ثبت‌نام</a>
                }
                <a href="@StorefrontRoutes.Privacy">حریم خصوصی</a>
                <a href="@StorefrontRoutes.Terms">قوانین و شرایط</a>
            </nav>
        </div>
        <p class="bs-v2-footer-copyright">© @DateTime.UtcNow.Year BlazorShop. تمامی حقوق محفوظ است.</p>
    </div>
</footer>

@code {
    [CascadingParameter]
    private StorefrontSessionInfo _session { get; set; } = StorefrontSessionInfo.Anonymous;
}