@page "/my-cart"
@inject StorefrontApiClient ApiClient
@inject IStorefrontClientAppUrlResolver ClientAppUrlResolver

<PageTitle>سبد خرید</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex,nofollow" />
</HeadContent>

<div class="bs-v2-container bs-v2-cart">
    <header class="bs-v2-cart-intro">
        <div>
            <p class="bs-v2-eyebrow">کیف شما</p>
            <h1>سبد خرید</h1>
            <p>محصولات خود را قبل از ادامه به پرداخت مرور کنید.</p>
        </div>
        <span class="bs-v2-count" role="status">@ItemCount محصول@(ItemCount == 1 ? string.Empty : " ها") در سبد خرید</span>
    </header>

    @foreach (var alert in Alerts)
    {
        <div class="bs-v2-cart-alert @(alert.Level == "error" ? "bs-v2-cart-error" : "bs-v2-cart-warning")" role="alert">
            @alert.Message
        </div>
    }

    <div class="bs-v2-cart-layout">
        <section class="bs-v2-cart-panel" aria-label="موارد سبد خرید">
            @if (Lines.Count == 0)
            {
                <div class="bs-v2-cart-empty" role="status">
                    <h2>سبد خرید شما خالی است</h2>
                    <p>محصولاتی از فروشگاه را اضافه کنید تا قبل از پرداخت در اینجا بررسی شوند.</p>
                    <div class="bs-v2-cart-empty-actions">
                        <a href="@StorefrontRoutes.NewReleases" class="bs-v2-button bs-v2-button-primary">خرید از جدیدترین‌ها</a>
                        <a href="@StorefrontRoutes.TodaysDeals" class="bs-v2-button bs-v2-button-secondary">مشاهده تخفیف‌ها</a>
                    </div>
                </div>
            }
            else
            {
                @for (var index = 0; index < Lines.Count; index++)
                {
                    var line = Lines[index];
                    var titleId = $"cart-title-{index}";
                    var variantId = $"cart-variant-{index}";
                    var quantityId = $"cart-quantity-{index}";
                    var removeDescription = string.IsNullOrWhiteSpace(line.VariantLabel) ? titleId : $"{titleId} {variantId}";
                    <article class="bs-v2-cart-line" aria-labelledby="@titleId">
                        <div class="bs-v2-cart-image">
                            @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                            {
                                <img src="@line.ImageUrl" alt="@line.DisplayName" width="88" height="88" />
                            }
                            else
                            {
                                <span class="bs-v2-image-placeholder">تصویر موجود نیست</span>
                            }
                        </div>
                        <div class="bs-v2-cart-product">
                            <h2 id="@titleId">
                                @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                                {
                                    <a href="@line.ProductUrl">@line.DisplayName</a>
                                }
                                else
                                {
                                    @line.DisplayName
                                }
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                            {
                                <p id="@variantId" class="bs-v2-cart-variant">@line.VariantLabel</p>
                            }
                            @if (line.IsUnavailable)
                            {
                                <p class="bs-v2-cart-unavailable">این کالا ناموجود است یا به‌روزرسانی نشد. قبل از پرداخت آن را بررسی کنید.</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                            {
                                <a href="@line.ProductUrl" class="bs-v2-cart-product-link">مشاهده کالا</a>
                            }
                        </div>
                        <div class="bs-v2-cart-line-controls">
                            <dl class="bs-v2-cart-prices">
                                <div><dt>قیمت واحد</dt><dd>@line.UnitPriceDisplay تومان</dd></div>
                                <div><dt>جمع ردیف</dt><dd>@line.LineTotalDisplay</dd></div>
                            </dl>
                            <div class="bs-v2-cart-line-actions">
                                <div class="bs-v2-cart-quantity">
                                    <label for="@quantityId">تعداد</label>
                                    <input id="@quantityId"
                                           type="number"
                                           min="1"
                                           step="1"
                                           value="@line.Quantity"
                                           aria-label="تعداد برای @line.DisplayName @line.VariantLabel"
                                           data-storefront-cart-quantity
                                           data-product-id="@line.ProductId"
                                           data-variant-id="@line.VariantId"
                                           data-product-name="@line.DisplayName"
                                           data-size-value="@line.SizeValue" />
                                </div>
                                <button type="button"
                                        class="bs-v2-button bs-v2-button-secondary bs-v2-cart-remove"
                                        aria-describedby="@removeDescription"
                                        data-storefront-cart-remove
                                        data-product-id="@line.ProductId"
                                        data-variant-id="@line.VariantId"
                                        data-product-name="@line.DisplayName"
                                        data-size-value="@line.SizeValue">حذف</button>
                            </div>
                        </div>
                    </article>
                }

                <p class="bs-v2-cart-notice">قیمت‌ها به‌صورت اطلاعاتی نمایش داده می‌شوند. سرور در زمان پرداخت دوباره محصولات، سایزها، قیمت‌ها و موجودی را بررسی می‌کند.</p>
            }
        </section>

        <aside class="bs-v2-cart-summary" aria-labelledby="cart-summary-heading">
            <h2 id="cart-summary-heading">خلاصه سفارش</h2>
            <dl class="bs-v2-cart-totals">
                <div><dt>تعداد</dt><dd>@ItemCount</dd></div>
                <div><dt>جمع جزء</dt><dd>@GrandTotalDisplay</dd></div>
                <div class="bs-v2-cart-total"><dt>کل</dt><dd>@GrandTotalDisplay</dd></div>
            </dl>
            <div class="bs-v2-cart-summary-actions">
                @if (Lines.Count > 0)
                {
                    <a href="@CheckoutUrl" class="bs-v2-button bs-v2-button-primary">ادامه به پرداخت</a>
                    <p>ادامه پرداخت با حساب شما انجام می‌شود.</p>
                    <button type="button" data-storefront-cart-clear class="bs-v2-button bs-v2-button-secondary">پاک‌سازی سبد</button>
                }
                <a href="@StorefrontRoutes.NewReleases" class="bs-v2-button bs-v2-button-secondary">ادامه خرید</a>
            </div>
        </aside>
    </div>
</div>
